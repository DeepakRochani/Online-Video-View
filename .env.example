# =============================================================================
# WEDDING PHOTOGRAPHER SAAS — PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.production or configure these variables in your
# hosting environment (Docker, VPS, Vercel, Railway, Render, AWS, etc.)
# DO NOT commit real production credentials to source control.
# =============================================================================

# 1. CORE PLATFORM & DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://drfilms.com
PLATFORM_DOMAIN=drfilms.com
PORT=3000

# 2. AUTHENTICATION & SESSION SECURITY
# -----------------------------------------------------------------------------
# Minimum 32-character random string for HMAC-SHA256 session token signatures
SESSION_SECRET=replace_with_64_char_secure_random_hex_string
MEDIA_SIGNING_SECRET=replace_with_64_char_secure_random_hex_string

# Initial Super Admin Bootstrap (Only used on first run if no super admin exists)
SUPER_ADMIN_EMAIL=admin@drfilms.com
SUPER_ADMIN_PASSWORD=replace_with_strong_super_admin_password

# 3. GOOGLE OAUTH LOGIN (Photographer Authentication)
# -----------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# Authorized JavaScript origins: https://drfilms.com
# Authorized redirect URIs: https://drfilms.com/api/auth/google/callback
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=https://drfilms.com/api/auth/google/callback

# 4. GOOGLE DRIVE OAUTH / SERVICE ACCOUNT (Media Storage & Video Streaming)
# -----------------------------------------------------------------------------
# Separate credentials for Drive connection or Service Account
GOOGLE_DRIVE_CLIENT_ID=your_google_drive_client_id.apps.googleusercontent.com
GOOGLE_DRIVE_CLIENT_SECRET=your_google_drive_client_secret
GOOGLE_DRIVE_REDIRECT_URI=https://drfilms.com/api/drive/callback

# Optional Service Account Alternative
# GOOGLE_SERVICE_ACCOUNT_EMAIL=sa@project.iam.gserviceaccount.com
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Fallback Public Folder API Key (Read-only scanning)
# GOOGLE_DRIVE_API_KEY=your_restricted_drive_api_key

# 5. RAZORPAY LIVE PAYMENT GATEWAY & WEBHOOKS
# -----------------------------------------------------------------------------
# Razorpay Dashboard -> Settings -> API Keys (LIVE Mode)
# Razorpay Dashboard -> Settings -> Webhooks -> Add New Webhook:
# Webhook URL: https://drfilms.com/api/webhooks/razorpay
# Secret: Configure below and enter exact same secret in Razorpay Dashboard
# Active Events: payment.captured, payment.failed, subscription.activated,
#                subscription.charged, subscription.cancelled, subscription.paused
RAZORPAY_KEY_ID=rzp_live_replace_with_live_key_id
RAZORPAY_KEY_SECRET=replace_with_live_key_secret
RAZORPAY_WEBHOOK_SECRET=replace_with_live_webhook_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace_with_live_key_id

# 6. TRANSACTIONAL EMAIL TRANSPORTS (Phase 27 Communication Service)
# -----------------------------------------------------------------------------
# Supported Providers: Resend (Default), SendGrid, or Custom SMTP
RESEND_API_KEY=re_live_replace_with_resend_api_key
EMAIL_FROM="DR Films Wedding Cinema <notifications@drfilms.com>"
EMAIL_REPLY_TO="support@drfilms.com"

# Optional SMTP Configuration
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=postmaster@drfilms.com
# SMTP_PASSWORD=smtp_secure_password

# 7. WHATSAPP BUSINESS CLOUD API (Optional Phase 27 Channel)
# -----------------------------------------------------------------------------
# Meta for Developers -> WhatsApp Business Cloud API
# WHATSAPP_API_TOKEN=your_meta_whatsapp_system_user_token
# WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
# WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_waba_id

# 8. AUTOMATED CRON & BACKGROUND JOB AUTHORIZATION
# -----------------------------------------------------------------------------
# Used to authenticate scheduled calls to /api/cron/gallery-lifecycle
CRON_SECRET=replace_with_secure_random_cron_token

# 9. GOOGLE ADSENSE (Optional - Public Landing & Free Tier Only)
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX

# 10. ERROR TRACKING & SENTRY (Optional Production APM)
# -----------------------------------------------------------------------------
# SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0
