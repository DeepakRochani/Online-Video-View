#!/usr/bin/env php
<?php

declare(strict_types=1);

if (php_sapi_name() !== 'cli') {
    echo "This script must be run from the command line.\n";
    exit(1);
}

// Autoload
if (file_exists(__DIR__ . '/../vendor/autoload.php')) {
    require_once __DIR__ . '/../vendor/autoload.php';
} else {
    spl_autoload_register(function ($class) {
        $prefix = 'App\\';
        $baseDir = __DIR__ . '/../app/';
        $len = strlen($prefix);
        if (strncmp($prefix, $class, $len) !== 0) return;
        $relativeClass = substr($class, $len);
        $file = $baseDir . str_replace('\\', '/', $relativeClass) . '.php';
        if (file_exists($file)) require $file;
    });
}

// Load .env
$envFile = __DIR__ . '/../.env';
if (file_exists($envFile)) {
    $lines = file($envFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
    foreach ($lines as $line) {
        if (str_starts_with(trim($line), '#') || !str_contains($line, '=')) continue;
        [$name, $value] = explode('=', $line, 2);
        $name = trim($name);
        $value = trim($value, " \t\n\r\0\x0B\"'");
        $_ENV[$name] = $value;
        putenv("{$name}={$value}");
    }
}

use App\Core\Database;
use App\Models\GallerySetting;
use App\Models\User;
use App\Services\DriveScannerService;

$command = $argv[1] ?? 'help';

switch ($command) {
    case 'migrate':
        echo "Running database schema migrations...\n";
        $schemaFile = __DIR__ . '/../database/schema.sql';
        if (!file_exists($schemaFile)) {
            echo "Error: schema.sql file not found.\n";
            exit(1);
        }
        $sql = file_get_contents($schemaFile);
        $pdo = Database::getInstance();
        $pdo->exec($sql);
        echo "✓ Database tables created successfully!\n";
        break;

    case 'seed':
        echo "Seeding initial photographer admin and default settings...\n";
        $user = User::findByEmail('admin@weddinggallery.com');
        if (!$user) {
            $userId = User::create([
                'name' => 'Studio Photographer',
                'email' => 'admin@weddinggallery.com',
                'password_hash' => password_hash('password123', PASSWORD_BCRYPT),
                'studio_name' => 'DR Films Cinema'
            ]);
            GallerySetting::setSetting($userId, 'studio_name', 'DR Films Cinema');
            GallerySetting::setSetting($userId, 'primary_color', '#D4AF37');
            GallerySetting::setSetting($userId, 'contact_email', 'admin@weddinggallery.com');
            echo "✓ Created photographer: admin@weddinggallery.com (password: password123)\n";
        } else {
            echo "✓ Photographer admin@weddinggallery.com already exists.\n";
        }
        break;

    case 'sync:drive':
        $weddingId = isset($argv[2]) ? (int)$argv[2] : 0;
        if (!$weddingId) {
            echo "Usage: php bin/console sync:drive <wedding_id>\n";
            exit(1);
        }
        echo "Scanning Google Drive for Wedding ID: {$weddingId}...\n";
        try {
            $scanner = new DriveScannerService();
            $result = $scanner->scanWeddingFolder($weddingId);
            echo "✓ Scan complete! Found {$result['total_videos']} videos across {$result['events_count']} event folders.\n";
        } catch (\Throwable $e) {
            echo "Error during scan: " . $e->getMessage() . "\n";
            exit(1);
        }
        break;

    default:
        echo "Wedding Video Gallery Platform CLI Console\n";
        echo "Usage: php bin/console <command>\n\n";
        echo "Available commands:\n";
        echo "  migrate                Execute database/schema.sql migrations\n";
        echo "  seed                   Seed initial admin user & branding\n";
        echo "  sync:drive <id>        Rescan Google Drive folder for a wedding\n";
        break;
}
