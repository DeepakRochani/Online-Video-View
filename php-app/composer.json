{
  "name": "drfilms/wedding-video-gallery-php",
  "description": "Professional Wedding Filmmaker Client Video Delivery Platform powered by Google Drive and MySQL",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.2",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-openssl": "*",
    "google/apiclient": "^2.15",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
